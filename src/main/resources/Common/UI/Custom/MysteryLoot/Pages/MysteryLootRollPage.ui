$C = "../../Common.ui";

$C.@DecoratedContainer {
  @CloseButton = true;
  Anchor: (Left: 50, Top: 80, Width: 460, Height: 700, Bottom: 80);

  #Title {
    Label {
      Style: (
        ...$C.@TitleStyle,
        HorizontalAlignment: Center,
      );
      Padding: (Horizontal: 19);
      Text: "Loot Table Simulator";
    }
  }

  #Content {
    FlexWeight: 1;
    LayoutMode: Top;
    Padding: (Horizontal: 12, Top: 8, Bottom: 12);

    // ── Table Selector ─────────────────────────────────────────────────────
    $C.@DropdownBox #TableDropdown {
      Anchor: (Left: 0, Right: 0, Height: 40);
    }

    Group { Anchor: (Height: 12); }
    Group { Anchor: (Height: 2); Background: (Color: #2b3542); }
    Group { Anchor: (Height: 12); }

    // ── Item List ──────────────────────────────────────────────────────────
    Label {
      Text: "Items in Table";
      Style: (TextColor: #8f9dae);
    }

    Group { Anchor: (Height: 8); }

    Group {
      FlexWeight: 1;
      LayoutMode: TopScrolling;
      ScrollbarStyle: $C.@DefaultScrollbarStyle;
      Padding: (Right: 6);

      Group #ItemListContainer {
        LayoutMode: Top;
        Anchor: (Left: 0, Right: 0);
      }
    }

    Group { Anchor: (Height: 12); }
    Group { Anchor: (Height: 2); Background: (Color: #2b3542); }
    Group { Anchor: (Height: 12); }

    // ── Roll Result ────────────────────────────────────────────────────────
    Group #ResultPanel {
      LayoutMode: Left;
      Anchor: (Left: 0, Right: 0, Height: 68);
      Visible: false;

      Group {
        Anchor: (Width: 60, Top: 0, Bottom: 0);
        Background: (Color: #1a2530);
        Padding: 2;

        ItemSlotButton {
          Anchor: (Full: 0);
          Disabled: true;

          ItemSlot #ResultItemSlot {
            Anchor: (Full: 0);
            ShowQualityBackground: true;
            ShowQuantity: true;
          }
        }
      }

      Group { Anchor: (Width: 10); }

      Group {
        FlexWeight: 1;
        LayoutMode: Top;
        Anchor: (Top: 0, Bottom: 0);

        Label #ResultItemIdLabel {
          Style: (
            TextColor: #62ffc0,
            FontSize: 14,
          );
          Text: "";
        }

        Group { Anchor: (Height: 4); }

        Label #RollCountLabel {
          Style: (
            TextColor: #8f9dae,
            FontSize: 11,
          );
          Text: "Roll #0";
        }
      }
    }

    Group { Anchor: (Height: 8); }

    // ── Roll Button ────────────────────────────────────────────────────────
    $C.@TextButton #RollButton {
      Anchor: (Left: 0, Right: 0, Height: 44);
      Text: "Roll!";
    }

    Group { Anchor: (Height: 4); }
  }
}
