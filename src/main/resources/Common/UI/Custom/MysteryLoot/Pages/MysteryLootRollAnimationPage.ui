$C = "../../Common.ui";

$C.@PageOverlay {
  LayoutMode: Middle;

  $C.@DecoratedContainer {
    Anchor: (Width: 240, Height: 260);

    #Title {
      Label {
        Style: (
          ...$C.@TitleStyle,
          HorizontalAlignment: Center,
        );
        Padding: (Horizontal: 19);
        Text: "Mystery Loot";
      }
    }

    #Content {
      LayoutMode: Top;
      Padding: (Horizontal: 16, Top: 20, Bottom: 16);

      // ── Flashing item icon ─────────────────────────────────────────
      Group {
        LayoutMode: Left;
        Anchor: (Left: 0, Right: 0);

        Group { FlexWeight: 1; }

        Group {
          Anchor: (Width: 120, Height: 120);
          Background: (Color: #1a2530);
          Padding: 4;

          ItemSlotButton {
            Anchor: (Full: 0);
            Disabled: true;

            ItemSlot #RollItemSlot {
              Anchor: (Full: 0);
              ShowQualityBackground: true;
              ShowQuantity: false;
            }
          }
        }

        Group { FlexWeight: 1; }
      }

      Group { Anchor: (Height: 16); }

      // ── Status label ──────────────────────────────────────────────
      Label #RollStatusLabel {
        Style: (
          TextColor: #8f9dae,
          FontSize: 14,
          HorizontalAlignment: Center,
        );
        Anchor: (Left: 0, Right: 0);
        Text: "Rolling...";
      }
    }
  }
}
