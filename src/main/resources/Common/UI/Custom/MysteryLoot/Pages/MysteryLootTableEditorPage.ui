$C = "../../Common.ui";

$C.@DecoratedContainer {
  @CloseButton = true;
  Anchor: (Left: 50, Top: 80, Width: 500, Height: 780, Bottom: 80);

  #Title {
    Label #PageTitle {
      Style: (
        ...$C.@TitleStyle,
        HorizontalAlignment: Center,
      );
      Padding: (Horizontal: 19);
      Text: "Loot Table Editor";
    }
  }

  #Content {
    FlexWeight: 1;
    LayoutMode: Top;
    Padding: (Horizontal: 12, Top: 8, Bottom: 12);

    Group {
      FlexWeight: 1;
      LayoutMode: TopScrolling;
      ScrollbarStyle: $C.@DefaultScrollbarStyle;
      Padding: (Full: 12);

      // ── Table Selector ───────────────────────────────────────────────────
      Group {
        Anchor: (Left: 0, Right: 0, Height: 40);
        LayoutMode: Left;

        $C.@DropdownBox #TableDropdown {
          FlexWeight: 1;
          Anchor: (Top: 0, Bottom: 0);
        }

        Group { Anchor: (Width: 8); }

        $C.@CancelTextButton #DeleteTableButton {
          Anchor: (Top: 0, Bottom: 0, Width: 90);
          Text: "DELETE";
          Visible: false;
        }
      }

      Group { Anchor: (Height: 16); }
      Group { Anchor: (Height: 2); Background: (Color: #2b3542); }
      Group { Anchor: (Height: 16); }

      // ── Table Name ───────────────────────────────────────────────────────
      Label {
        Text: "Table Name";
        Style: (TextColor: #8f9dae);
      }

      Group { Anchor: (Height: 8); }

      $C.@TextField #TableNameInput {
        @Anchor = (Height: 40);
        PlaceholderText: "Unique name (e.g. Zombie_Drops)...";
      }

      Group { Anchor: (Height: 6); }

      Label #ErrorLabel {
        Style: (TextColor: #e05555);
        Visible: false;
      }

      Group { Anchor: (Height: 16); }
      Group { Anchor: (Height: 2); Background: (Color: #2b3542); }
      Group { Anchor: (Height: 16); }

      // ── Required Key ──────────────────────────────────────────────────────
      Label {
        Text: "Required Key";
        Style: (TextColor: #8f9dae);
      }

      Group { Anchor: (Height: 8); }

      Group {
        Anchor: (Left: 0, Right: 0);
        LayoutMode: Left;

        Group {
          FlexWeight: 1;
          LayoutMode: Top;

          Label {
            Text: "Item ID (leave empty for none)";
            Style: (TextColor: #8f9dae);
          }

          Group { Anchor: (Height: 8); }

          $C.@TextField #KeyItemIdInput {
            @Anchor = (Height: 40);
            PlaceholderText: "e.g. Mystery_Box_Key...";
          }
        }

        Group { Anchor: (Width: 12); }

        Group {
          Anchor: (Width: 100);
          LayoutMode: Top;

          Label {
            Text: "Amount";
            Style: (TextColor: #8f9dae);
          }

          Group { Anchor: (Height: 8); }

          $C.@NumberField #KeyAmountInput {
            @Anchor = (Height: 40);
            Format: (
              MaxDecimalPlaces: 0,
              Step: 1,
              MinValue: 1,
              MaxValue: 999
            );
            Value: 1;
          }
        }
      }

      Group { Anchor: (Height: 16); }
      Group { Anchor: (Height: 2); Background: (Color: #2b3542); }
      Group { Anchor: (Height: 16); }

      // ── Item List ────────────────────────────────────────────────────────
      Label {
        Text: "Loot Items";
        Style: (TextColor: #8f9dae);
      }

      Group { Anchor: (Height: 8); }

      Group {
        Anchor: (Left: 0, Right: 0, Height: 40);
        LayoutMode: Left;

        $C.@DropdownBox #ItemListDropdown {
          FlexWeight: 1;
          Anchor: (Top: 0, Bottom: 0);
        }

        Group { Anchor: (Width: 8); }

        $C.@CancelTextButton #RemoveItemButton {
          Anchor: (Top: 0, Bottom: 0, Width: 90);
          Text: "REMOVE";
          Visible: false;
        }
      }

      Group { Anchor: (Height: 16); }
      Group { Anchor: (Height: 2); Background: (Color: #2b3542); }
      Group { Anchor: (Height: 16); }

      // ── Item Form ────────────────────────────────────────────────────────
      Label {
        Text: "Item ID";
        Style: (TextColor: #8f9dae);
      }

      Group { Anchor: (Height: 8); }

      $C.@TextField #ItemIdInput {
        @Anchor = (Height: 40);
        PlaceholderText: "Enter item ID (e.g. arc:sword)...";
      }

      Group { Anchor: (Height: 12); }

      Group {
        Anchor: (Left: 0, Right: 0);
        LayoutMode: Left;

        Group {
          FlexWeight: 1;
          LayoutMode: Top;

          Label {
            Text: "Amount";
            Style: (TextColor: #8f9dae);
          }

          Group { Anchor: (Height: 8); }

          $C.@NumberField #ItemAmountInput {
            @Anchor = (Height: 40);
            Format: (
              MaxDecimalPlaces: 0,
              Step: 1,
              MinValue: 1,
              MaxValue: 999
            );
            Value: 1;
          }
        }

        Group { Anchor: (Width: 12); }

        Group {
          FlexWeight: 1;
          LayoutMode: Top;

          Label {
            Text: "Drop Weight";
            Style: (TextColor: #8f9dae);
          }

          Group { Anchor: (Height: 8); }

          $C.@NumberField #ItemDropChanceInput {
            @Anchor = (Height: 40);
            Format: (
              MaxDecimalPlaces: 3,
              Step: 0.005,
              MinValue: 0.005,
              MaxValue: 9999
            );
            Value: 1.0;
          }
        }
      }

      Group { Anchor: (Height: 12); }

      // ── Announce Win ──────────────────────────────────────────────────────
      $C.@CheckBoxWithLabel #AnnounceWinRow {
        @Text = "Announce win in chat";
        @Checked = false;
      }

      // ── Reward Sound ──────────────────────────────────────────────────────
      Label {
        Text: "Reward Sound";
        Style: (TextColor: #8f9dae);
      }

      Group { Anchor: (Height: 8); }

      $C.@DropdownBox #RewardSoundDropdown {
        Anchor: (Left: 0, Right: 0, Height: 40);
      }

      Group { Anchor: (Height: 12); }

      $C.@SecondaryTextButton #AddItemButton {
        Anchor: (Left: 0, Right: 0, Height: 40);
        Text: "Add Item to Table";
      }

      Group { Anchor: (Height: 16); }
    }

    // ── Footer ───────────────────────────────────────────────────────────────
    Group { Anchor: (Height: 2); Background: (Color: #2b3542); }
    Group { Anchor: (Height: 12); }

    $C.@TextButton #SaveTableButton {
      Anchor: (Left: 0, Right: 0, Height: 40);
      Text: "Save Loot Table";
    }

    Group { Anchor: (Height: 4); }
  }
}
