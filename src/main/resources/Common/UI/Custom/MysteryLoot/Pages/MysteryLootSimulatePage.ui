$C = "../../Common.ui";

$C.@DecoratedContainer {
  @CloseButton = true;
  Anchor: (Left: 50, Top: 60, Width: 500, Height: 800, Bottom: 60);

  #Title {
    Label {
      Style: (
        ...$C.@TitleStyle,
        HorizontalAlignment: Center,
      );
      Padding: (Horizontal: 19);
      Text: "Loot Table Simulator";
    }
  }

  #Content {
    FlexWeight: 1;
    LayoutMode: Top;
    Padding: (Horizontal: 12, Top: 8, Bottom: 12);

    // ── Table Selector ─────────────────────────────────────────────────────
    $C.@DropdownBox #TableDropdown {
      Anchor: (Left: 0, Right: 0, Height: 40);
    }

    Group { Anchor: (Height: 10); }
    Group { Anchor: (Height: 2); Background: (Color: #2b3542); }
    Group { Anchor: (Height: 10); }

    // ── Item List ──────────────────────────────────────────────────────────
    Label {
      Text: "Items in Table";
      Style: (TextColor: #8f9dae);
    }

    Group { Anchor: (Height: 6); }

    Group {
      Anchor: (Left: 0, Right: 0);
      FlexWeight: 1;
      LayoutMode: TopScrolling;
      ScrollbarStyle: $C.@DefaultScrollbarStyle;
      Padding: (Right: 4);

      Group #ItemListContainer {
        LayoutMode: Top;
        Anchor: (Left: 0, Right: 0);
      }
    }

    Group { Anchor: (Height: 10); }
    Group { Anchor: (Height: 2); Background: (Color: #2b3542); }
    Group { Anchor: (Height: 10); }

    // ── Last Result ────────────────────────────────────────────────────────
    Group #ResultPanel {
      LayoutMode: Left;
      Anchor: (Left: 0, Right: 0, Height: 60);
      Visible: false;

      Group {
        Anchor: (Width: 52, Top: 0, Bottom: 0);
        Background: (Color: #1a2530);
        Padding: 2;

        ItemSlotButton {
          Anchor: (Full: 0);
          Disabled: true;

          ItemSlot #ResultItemSlot {
            Anchor: (Full: 0);
            ShowQualityBackground: true;
            ShowQuantity: true;
          }
        }
      }

      Group { Anchor: (Width: 10); }

      Label #ResultItemIdLabel {
        FlexWeight: 1;
        Style: (
          TextColor: #62ffc0,
          FontSize: 14,
        );
        Text: "";
      }
    }

    Group { Anchor: (Height: 10); }
    Group { Anchor: (Height: 2); Background: (Color: #2b3542); }
    Group { Anchor: (Height: 10); }

    // ── History ────────────────────────────────────────────────────────────
    Group {
      LayoutMode: Left;
      Anchor: (Left: 0, Right: 0, Height: 20);

      Label #TotalRollsLabel {
        FlexWeight: 1;
        Style: (TextColor: #8f9dae);
        Text: "Total Rolls: 0";
      }

      $C.@SecondaryTextButton #ClearHistoryButton {
        Anchor: (Top: 0, Bottom: 0, Width: 60);
        Text: "Clear";
        Visible: false;
      }
    }

    Group { Anchor: (Height: 6); }

    Group {
      Anchor: (Left: 0, Right: 0);
      FlexWeight: 1;
      LayoutMode: TopScrolling;
      ScrollbarStyle: $C.@DefaultScrollbarStyle;
      Padding: (Right: 4);

      Group #HistoryListContainer {
        LayoutMode: Top;
        Anchor: (Left: 0, Right: 0);
      }
    }

    Group { Anchor: (Height: 10); }
    Group { Anchor: (Height: 2); Background: (Color: #2b3542); }
    Group { Anchor: (Height: 8); }

    // ── Roll Buttons ───────────────────────────────────────────────────────
    Group {
      Anchor: (Left: 0, Right: 0, Height: 40);
      LayoutMode: Left;

      $C.@TextButton #Roll1Button {
        FlexWeight: 1;
        Anchor: (Top: 0, Bottom: 0);
        Text: "Roll x1";
      }

      Group { Anchor: (Width: 6); }

      $C.@TextButton #Roll5Button {
        FlexWeight: 1;
        Anchor: (Top: 0, Bottom: 0);
        Text: "Roll x5";
      }

      Group { Anchor: (Width: 6); }

      $C.@TextButton #Roll10Button {
        FlexWeight: 1;
        Anchor: (Top: 0, Bottom: 0);
        Text: "Roll x10";
      }
    }

    Group { Anchor: (Height: 4); }
  }
}
