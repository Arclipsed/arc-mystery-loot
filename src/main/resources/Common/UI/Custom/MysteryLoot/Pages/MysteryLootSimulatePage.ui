$C = "../../Common.ui";

$C.@DecoratedContainer {
  @CloseButton = true;
  Anchor: (Left: 50, Top: 60, Width: 500, Height: 800, Bottom: 60);

  #Title {
    Label {
      Style: (
        ...$C.@TitleStyle,
        HorizontalAlignment: Center,
      );
      Padding: (Horizontal: 19);
      Text: "Loot Table Simulator";
    }
  }

  #Content {
    FlexWeight: 1;
    LayoutMode: Top;
    Padding: (Horizontal: 12, Top: 8, Bottom: 12);

    // ── Table Selector ─────────────────────────────────────────────────────
    $C.@DropdownBox #TableDropdown {
      Anchor: (Left: 0, Right: 0, Height: 40);
    }

    Group { Anchor: (Height: 10); }
    Group { Anchor: (Height: 2); Background: (Color: #2b3542); }
    Group { Anchor: (Height: 10); }

    // ── Item List ──────────────────────────────────────────────────────────
    Label {
      Text: "Drop Weights";
      Style: (TextColor: #8f9dae);
    }

    Group { Anchor: (Height: 6); }

    Group {
      Anchor: (Left: 0, Right: 0);
      FlexWeight: 1;
      LayoutMode: TopScrolling;
      ScrollbarStyle: $C.@DefaultScrollbarStyle;
      Padding: (Right: 4);

      Group #ItemListContainer {
        LayoutMode: Top;
        Anchor: (Left: 0, Right: 0);
      }
    }

    Group { Anchor: (Height: 10); }
    Group { Anchor: (Height: 2); Background: (Color: #2b3542); }
    Group { Anchor: (Height: 10); }

    // ── Roll Buttons ───────────────────────────────────────────────────────
    Group {
      Anchor: (Left: 0, Right: 0, Height: 40);
      LayoutMode: Left;

      $C.@TextButton #Roll1Button {
        FlexWeight: 1;
        Anchor: (Top: 0, Bottom: 0);
        Text: "Roll x1";
      }

      Group { Anchor: (Width: 6); }

      $C.@TextButton #Roll10Button {
        FlexWeight: 1;
        Anchor: (Top: 0, Bottom: 0);
        Text: "Roll x10";
      }

      Group { Anchor: (Width: 6); }

      $C.@TextButton #Roll100Button {
        FlexWeight: 1;
        Anchor: (Top: 0, Bottom: 0);
        Text: "Roll x100";
      }
    }

    Group { Anchor: (Height: 10); }
    Group { Anchor: (Height: 2); Background: (Color: #2b3542); }
    Group { Anchor: (Height: 10); }

    // ── Stats Overview ─────────────────────────────────────────────────────
    Group {
      LayoutMode: Left;
      Anchor: (Left: 0, Right: 0, Height: 20);

      Label #TotalRollsLabel {
        FlexWeight: 1;
        Style: (TextColor: #8f9dae);
        Text: "";
      }

      $C.@CancelTextButton #ResetButton {
        Anchor: (Top: 0, Bottom: 0, Width: 65);
        Text: "Reset";
        Visible: false;
      }
    }

    Group { Anchor: (Height: 6); }

    Group #StatsPanel {
      Anchor: (Left: 0, Right: 0);
      FlexWeight: 1;
      LayoutMode: TopScrolling;
      ScrollbarStyle: $C.@DefaultScrollbarStyle;
      Padding: (Right: 4);
      Visible: false;

      Group #StatsListContainer {
        LayoutMode: Top;
        Anchor: (Left: 0, Right: 0);
      }
    }

    Group { Anchor: (Height: 4); }
  }
}
