$C = "../../Common.ui";

$C.@PageOverlay {
  LayoutMode: Middle;

  $C.@DecoratedContainer {
    @CloseButton = true;
    Anchor: (Width: 532, Height: 520);

    #Title {
      Label #TableNameLabel {
        Style: (
          ...$C.@TitleStyle,
          HorizontalAlignment: Center,
        );
        Padding: (Horizontal: 19);
        Text: "Mystery Loot";
      }
    }

    #Content {
      FlexWeight: 1;
      LayoutMode: Top;

      // Scrollable item card row
      Group {
        Anchor: (Left: 0, Right: 0);
        FlexWeight: 1;
        LayoutMode: TopScrolling;
        ScrollbarStyle: $C.@DefaultScrollbarStyle;

        Group {
          LayoutMode: Left;
          Anchor: (Left: 0, Right: 0);

          Group { FlexWeight: 1; }

          Group #LootItemsContainer {
            LayoutMode: Top;
          }

          Group { FlexWeight: 1; }
        }
      }

      Group { Anchor: (Height: 12); }
      Group { Anchor: (Height: 2); Background: (Color: #2b3542); }

      $C.@TextButton #RollButton {
        Anchor: (Left: 0, Right: 0, Height: 44);
        Text: "Open Loot";
      }
    }
  }
}

$C.@BackButton {}
