$C = "../../Common.ui";

$C.@PageOverlay {
  LayoutMode: Middle;

  $C.@DecoratedContainer {
    @CloseButton = true;
    Anchor: (Width: 532, Height: 520);

    #Title {
      Label #TableNameLabel {
        Style: (
          ...$C.@TitleStyle,
          HorizontalAlignment: Center,
        );
        Padding: (Horizontal: 19);
        Text: "Mystery Loot";
      }
    }

    #Content {
      FlexWeight: 1;
      LayoutMode: Top;

      // Scrollable item card row
      Group {
        Anchor: (Left: 0, Right: 0);
        FlexWeight: 1;
        LayoutMode: TopScrolling;
        ScrollbarStyle: $C.@DefaultScrollbarStyle;

        Group {
          LayoutMode: Left;
          Anchor: (Left: 0, Right: 0);

          Group { FlexWeight: 1; }

          Group #LootItemsContainer {
            LayoutMode: Top;
          }

          Group { FlexWeight: 1; }
        }
      }

      // ── Result separator (hidden until rolled) ──────────────────────────
      Group #ResultSeparator {
        Anchor: (Left: 0, Right: 0);
        LayoutMode: Top;
        Visible: false;

        Group { Anchor: (Height: 12); }
        Group { Anchor: (Height: 1); Background: (Color: #2b3542); }
        Group { Anchor: (Height: 12); }
      }

      // ── Result ────────────────────────────────────────────────────────
      Group #ResultPanel {
        LayoutMode: Middle;
        Anchor: (Left: 0, Right: 0, Height: 130);
        Visible: false;

        Group {
          LayoutMode: Top;

          // Icon centered horizontally
          Group {
            LayoutMode: Left;

            Group { FlexWeight: 1; }

            Group {
              Anchor: (Width: 72, Height: 72);
              Background: (Color: #1a2530);
              Padding: 3;

              ItemSlotButton {
                Anchor: (Full: 0);
                Disabled: true;

                ItemSlot #ResultItemSlot {
                  Anchor: (Full: 0);
                  ShowQualityBackground: true;
                  ShowQuantity: true;
                }
              }
            }

            Group { FlexWeight: 1; }
          }

          Group { Anchor: (Height: 8); }

          Label #ResultItemNameLabel {
            Style: (
              TextColor: #62ffc0,
              FontSize: 16,
              HorizontalAlignment: Center,
            );
            Text: "";
          }

          Group { Anchor: (Height: 3); }

          Label #ResultAmountLabel {
            Style: (
              TextColor: #8f9dae,
              FontSize: 13,
              HorizontalAlignment: Center,
            );
            Text: "";
          }
        }
      }

      Group { Anchor: (Height: 12); }
      Group { Anchor: (Height: 2); Background: (Color: #2b3542); }
      Group { Anchor: (Height: 12); }

      // ── Roll button ───────────────────────────────────────────────────
      $C.@TextButton #RollButton {
        Anchor: (Left: 0, Right: 0, Height: 44);
        Text: "Open Loot";
      }
    }
  }
}

$C.@BackButton {}
