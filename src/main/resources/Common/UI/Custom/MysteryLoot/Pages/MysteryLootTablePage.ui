$C = "../../Common.ui";

$C.@PageOverlay {
  LayoutMode: Middle;

  $C.@DecoratedContainer {
    @CloseButton = true;
    Anchor: (Width: 532, Height: 520);

    #Title {
      Label #TableNameLabel {
        Style: (
          ...$C.@TitleStyle,
          HorizontalAlignment: Center,
        );
        Padding: (Horizontal: 19);
        Text: "Mystery Loot";
      }
    }

    #Content {
      FlexWeight: 1;
      LayoutMode: Top;

      // Scrollable item card row
      Group {
        Anchor: (Left: 0, Right: 0);
        FlexWeight: 1;
        LayoutMode: TopScrolling;
        ScrollbarStyle: $C.@DefaultScrollbarStyle;

        Group {
          LayoutMode: Left;
          Anchor: (Left: 0, Right: 0);

          Group { FlexWeight: 1; }

          Group #LootItemsContainer {
            LayoutMode: Top;
          }

          Group { FlexWeight: 1; }
        }
      }

      Group { Anchor: (Height: 2); Background: (Color: #2b3542); }
      Group { Anchor: (Height: 12); }

      Group {
        LayoutMode: Left;
        Anchor: (Left: 0, Right: 0, Height: 65);

        // Required key item (hidden when not configured)
        Group #RequiredKeyGroup {
          LayoutMode: Left;
          Visible: false;
          Anchor: (Height: 65);

          Group {
            Anchor: (Width: 65, Height: 65);
            Background: (Color: #1a2530);
            Padding: 2;

            ItemSlotButton {
              Anchor: (Full: 0);
              Disabled: true;

              ItemSlot #RequiredKeySlot {
                Anchor: (Full: 0);
                ShowQualityBackground: true;
                ShowQuantity: true;
              }
            }
          }

          Group { Anchor: (Width: 8); }
        }

        $C.@TextButton #RollButton {
          FlexWeight: 1;
          Anchor: (Height: 65);
          Text: "Open Loot";
        }
      }
    }
  }
}

$C.@BackButton {}
