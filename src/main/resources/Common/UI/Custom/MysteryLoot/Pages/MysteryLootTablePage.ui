$C = "../../Common.ui";

$C.@PageOverlay {
  LayoutMode: Middle;

  $C.@DecoratedContainer {
    @CloseButton = true;
    Anchor: (Width: 532, Height: 520);

    #Title {
      Label #TableNameLabel {
        Style: (
          ...$C.@TitleStyle,
          HorizontalAlignment: Center,
        );
        Padding: (Horizontal: 19);
        Text: "Mystery Loot";
      }
    }

    #Content {
      FlexWeight: 1;
      LayoutMode: Top;

      // Scrollable item card row
      Group {
        Anchor: (Left: 0, Right: 0);
        FlexWeight: 1;
        LayoutMode: TopScrolling;
        ScrollbarStyle: $C.@DefaultScrollbarStyle;

        Group {
          LayoutMode: Left;
          Anchor: (Left: 0, Right: 0);

          Group { FlexWeight: 1; }

          Group #LootItemsContainer {
            LayoutMode: Top;
          }

          Group { FlexWeight: 1; }
        }
      }

      // ── Result ────────────────────────────────────────────────────────
      Group #ResultPanel {
        LayoutMode: Left;
        Anchor: (Left: 0, Right: 0, Height: 80);
        Visible: false;

        Group {
          Anchor: (Width: 72, Height: 72, Top: 4);
          Background: (Color: #1a2530);
          Padding: 3;

          ItemSlotButton {
            Anchor: (Full: 0);
            Disabled: true;

            ItemSlot #ResultItemSlot {
              Anchor: (Full: 0);
              ShowQualityBackground: true;
              ShowQuantity: true;
            }
          }
        }

        Group { Anchor: (Width: 12); }

        Group {
          FlexWeight: 1;
          LayoutMode: Top;
          Anchor: (Top: 0, Bottom: 0);

          Label #ResultItemNameLabel {
            Style: (
              TextColor: #62ffc0,
              FontSize: 16,
            );
            Text: "";
          }

          Group { Anchor: (Height: 4); }

          Label #ResultAmountLabel {
            Style: (
              TextColor: #8f9dae,
              FontSize: 13,
            );
            Text: "";
          }
        }
      }

      Group { Anchor: (Height: 12); }
      Group { Anchor: (Height: 2); Background: (Color: #2b3542); }
      Group { Anchor: (Height: 12); }

      // ── Roll button ───────────────────────────────────────────────────
      $C.@TextButton #RollButton {
        Anchor: (Left: 0, Right: 0, Height: 44);
        Text: "Open Loot";
      }
    }
  }
}

$C.@BackButton {}
