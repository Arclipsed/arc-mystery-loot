$C = "../../Common.ui";

$C.@DecoratedContainer {
  @CloseButton = true;
  Anchor: (Left: 50, Top: 80, Width: 500, Height: 400, Bottom: 80);

  #Title {
    Label #PageTitle {
      Style: (
        ...$C.@TitleStyle,
        HorizontalAlignment: Center,
      );
      Padding: (Horizontal: 19);
      Text: "Manage Loot Tables";
    }
  }

  #Content {
    FlexWeight: 1;
    LayoutMode: Top;
    Padding: (Horizontal: 12, Top: 8, Bottom: 12);

    Group {
      FlexWeight: 1;
      LayoutMode: TopScrolling;
      ScrollbarStyle: $C.@DefaultScrollbarStyle;
      Padding: (Full: 12);

      // ── Table List ────────────────────────────────────────────────────
      Group {
        Anchor: (Left: 0, Right: 0, Height: 40);
        LayoutMode: Left;

        $C.@DropdownBox #TableListDropdown {
          FlexWeight: 1;
          Anchor: (Top: 0, Bottom: 0);
        }

        Group { Anchor: (Width: 8); }

        $C.@CancelTextButton #DeleteTableButton {
          Anchor: (Top: 0, Bottom: 0, Width: 90);
          Text: "DEL";
          Visible: false;
        }
      }

      Group { Anchor: (Height: 16); }
      Group { Anchor: (Height: 2); Background: (Color: #2b3542); }
      Group { Anchor: (Height: 16); }

      // ── Edit Form ──────────────────────────────────────────────────────
      Label {
        Text: "Loot Table Name";
        Style: (
          TextColor: #8f9dae,
        );
      }

      Group { Anchor: (Height: 8); }

      $C.@TextField #TableNameInput {
        @Anchor = (Height: 40);
        PlaceholderText: "Unique table name (e.g. Zombie_Drops)...";
      }

      Group { Anchor: (Height: 16); }
    }  // end scrolling group

    // ── Save (fixed footer — always visible) ──────────────────────────────
    Group { Anchor: (Height: 12); }

    $C.@TextButton #SaveTableButton {
      Anchor: (Left: 0, Right: 0, Height: 40);
      Text: "Save Table";
    }

    Group { Anchor: (Height: 4); }
  }   // end #Content
}
