$C = "../../Common.ui";

$C.@PageOverlay {
  LayoutMode: Middle;

  $C.@DecoratedContainer {
    @CloseButton = false;
    Anchor: (Width: 500, Height: 350);

    #Title {
      Label #DialogTitle {
        Style: (
          ...$C.@TitleStyle,
          HorizontalAlignment: Center,
        );
        Padding: (Horizontal: 19);
        Text: "NPC Name";
      }
    }

    #Content {
      FlexWeight: 1;
      LayoutMode: Top;
      Padding: (Horizontal: 12, Top: 8, Bottom: 12);

      Group #DialogTextContainer {
        FlexWeight: 1;
        LayoutMode: TopScrolling;
        ScrollbarStyle: $C.@DefaultScrollbarStyle;
        Padding: (Full: 12);

        Label #DialogTextLabel {
          Text: "Dialog Text Goes Here...";
          Style: (
            FontSize: 18,
            HorizontalAlignment: Center,
            TextColor: #ffffff,
            Wrap: true,
          );
        }
      }

      Group { Anchor: (Height: 1); Background: (Color: #2b3542); }
      Group { Anchor: (Height: 12); }

      Group #ActionButtons {
        LayoutMode: Top;

        $C.@TextButton #OkButton {
          @Text = "OK";
          @Anchor = (Height: 40);
        }

        Group { Anchor: (Height: 10); }

        $C.@SecondaryTextButton #CancelButton {
          @Text = "Close";
          @Anchor = (Height: 40);
        }
      }
    }
  }
}

